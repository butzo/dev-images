// Committed, portable devcontainer config.
//
// All mounts live here: the CLI's own `--mount` flag only accepts
// type=bind|volume,source,target (no readonly, no tmpfs), while string
// entries below go verbatim to `podman run --mount`.
{
  "name": "arch-dev",
  "image": "ghcr.io/butzo/arch-dev:aio",
  "remoteUser": "dev",
  "updateRemoteUserUID": false,
  "runArgs": [
    "--userns=keep-id"
  ],
  // Path identity: the workspace sits at its host path inside the container,
  // so absolute paths in tool output (e.g. Claudian's) resolve on the host.
  "workspaceMount": "type=bind,source=${localWorkspaceFolder},target=${localWorkspaceFolder}",
  "workspaceFolder": "${localWorkspaceFolder}",
  "mounts": [
    // Confidential masks: empty tmpfs over git-crypt plaintext and key, so
    // nothing in the container (agents included) can read them. Committed on
    // purpose: they apply on every start path (just up/rebuild, VS Code).
    // notmpcopyup is essential: podman's default tmpcopyup copies the host
    // files from the workspace bind mount INTO the tmpfs, leaking them.
    "type=tmpfs,target=${localWorkspaceFolder}/confidential,notmpcopyup",
    "type=tmpfs,target=${localWorkspaceFolder}/.git/git-crypt,notmpcopyup",
    // Read-only overlays: paths the HOST executes (git hooks/config via host
    // git and obsidian-git, host Claude Code project settings/hooks, this
    // devcontainer, the justfile). Writable, they would let an agent run code
    // on the host, where the confidential plaintext lives. Bind sources must
    // exist on the host, or podman refuses to start.
    "type=bind,source=${localWorkspaceFolder}/.git/hooks,target=${localWorkspaceFolder}/.git/hooks,readonly",
    "type=bind,source=${localWorkspaceFolder}/.git/config,target=${localWorkspaceFolder}/.git/config,readonly",
    "type=bind,source=${localWorkspaceFolder}/.devcontainer,target=${localWorkspaceFolder}/.devcontainer,readonly",
    "type=bind,source=${localWorkspaceFolder}/justfile,target=${localWorkspaceFolder}/justfile,readonly",
    // Comment out only if you never run Claude Code on the host here.
    "type=bind,source=${localWorkspaceFolder}/.claude,target=${localWorkspaceFolder}/.claude,readonly",
    // Obsidian vaults: plugin code Obsidian loads, and Claudian's transcripts
    // (may hold confidential notes attached in the host UI). `just up` refuses
    // if .obsidian/ exists while these are commented out.
    // "type=bind,source=${localWorkspaceFolder}/.obsidian,target=${localWorkspaceFolder}/.obsidian,readonly",
    // "type=tmpfs,target=${localWorkspaceFolder}/.claudian,notmpcopyup",
    // Personal mount slots (dotfiles, .claude seed), filled from
    // ~/.config/devcontainer/mounts.env which the justfile loads before `up`.
    // Unset slot -> harmless empty tmpfs, so collaborators/CI need nothing.
    "${localEnv:DEVC_MOUNT_1:type=tmpfs,target=/tmp/.devc-unused-1}",
    "${localEnv:DEVC_MOUNT_2:type=tmpfs,target=/tmp/.devc-unused-2}",
    "${localEnv:DEVC_MOUNT_3:type=tmpfs,target=/tmp/.devc-unused-3}",
    "${localEnv:DEVC_MOUNT_4:type=tmpfs,target=/tmp/.devc-unused-4}",
    "${localEnv:DEVC_MOUNT_5:type=tmpfs,target=/tmp/.devc-unused-5}",
    "${localEnv:DEVC_MOUNT_6:type=tmpfs,target=/tmp/.devc-unused-6}",
    "${localEnv:DEVC_MOUNT_7:type=tmpfs,target=/tmp/.devc-unused-7}",
    "${localEnv:DEVC_MOUNT_8:type=tmpfs,target=/tmp/.devc-unused-8}",
    "${localEnv:DEVC_MOUNT_9:type=tmpfs,target=/tmp/.devc-unused-9}",
    "${localEnv:DEVC_MOUNT_10:type=tmpfs,target=/tmp/.devc-unused-10}"
  ],
  "containerEnv": {
    "TZ": "Europe/Berlin",
    "TERM": "xterm-256color",
    // Shown by the `container` segment in ~/.p10k.zsh
    "DEVCONTAINER_NAME": "${localWorkspaceFolderBasename}"
  },
  // "remoteEnv": {
  //   "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}"
  // },
  "postCreateCommand": ".devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": []
    }
  }
}
