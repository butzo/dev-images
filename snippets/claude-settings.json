{
  "permissions": {
    "defaultMode": "default"
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "excludedPaths": [
      "~/.claude"
    ],
    "network": {
      "allowUnixSockets": [],
      "allowedDomains": [
        "api.anthropic.com",
        "geo.mirror.pkgbuild.com",
        "crates.io",
        "static.crates.io",
        "index.crates.io",
        "pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org",
        "github.com",
        "raw.githubusercontent.com",
        "codeload.github.com"
      ]
    }
  }
}
